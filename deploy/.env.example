# Production settings. Copy to deploy/.env, fill in every value, keep it secret.

# --- Site -----------------------------------------------------------------
# Public domain; DNS A record must point here
SITE_ADDRESS=school.example.com
# Let's Encrypt expiry notices
ACME_EMAIL=it@example.com
ALLOWED_HOSTS=school.example.com
CSRF_TRUSTED_ORIGINS=https://school.example.com
FRONTEND_URL=https://school.example.com
# Used for the daily jobs schedule
TIME_ZONE=Asia/Kathmandu

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
POSTGRES_DB=school
POSTGRES_USER=school
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# --- Email (notifications, password resets) --------------------------------
# smtp+tls://USER:PASSWORD@HOST:587   (URL-encode special characters in the password)
EMAIL_URL=
DEFAULT_FROM_EMAIL=School <no-reply@example.com>

# --- Uploads --------------------------------------------------------------
FILE_UPLOAD_MAX_MB=10

# --- Backups --------------------------------------------------------------
# Mount an off-server/synced disk here if possible
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# UTC
BACKUP_HOUR=2

# --- Optional error tracking ------------------------------------------------
SENTRY_DSN=
