# Production web server. SITE_ADDRESS is the public domain (e.g. school.example.com);
# Caddy obtains and renews its HTTPS certificate automatically.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API, WebSockets, Django admin and health checks go to Daphne.
	@backend path /api/* /ws/* /admin/* /health/ /ready/
	handle @backend {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Django's own static files (admin, API docs), collected into a shared volume.
	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	# The single-page app: hashed assets are cached for a year, everything else
	# (index.html for every route) is revalidated so deploys show up at once.
	handle {
		root * /srv
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json
	}
}
